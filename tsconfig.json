{
    "compilerOptions": {
        "outDir": "./dist/",
        "noImplicitAny": true,
        "strictPropertyInitialization": false,
        "strict": true,
        "module": "es6",
        "target": "es5",
        "allowJs": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "sourceMap": true
    },
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS"
        }
    }
}